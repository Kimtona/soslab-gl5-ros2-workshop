# Copy to .env and edit.

# Registry path, set once the image is pushed.
IMAGE=ghcr.io/kimtona/soslab-gl5-ros2-workshop

# prebuilt = everything already built (fallback)
# dev      = SDK source only, you build it (the exercise)
TAG=prebuilt

# Viewers only: the LAN address of the team's LiDAR host.
ROUTER_HOST=192.168.50.23

# LiDAR host only. Read the real values off the sensor first:
#   soslab_ethinfo --ip 192.168.1.10 --port 2000
SOSLAB_DEVICE_IP=192.168.1.10
SOSLAB_DEVICE_PORT=2000
SOSLAB_PC_IP=0.0.0.0
SOSLAB_PC_PORT=0

# One per team so graphs don't merge on a shared router.
#   1조 71   2조 72   3조 73   4조 74   5조 75   기준국 77
# Keep these off race_stack's 48 and 6.
ROS_DOMAIN_ID=77

# Optional. Set a VNC password if the host is on a shared network and you don't
# want anyone on the wifi opening its RViz. Empty means no password.
VNC_PASSWORD=

# Reference station only. Record with:
#   ros2 bag record -o reference_bag /lidar0/pointcloud
# and leave the result next to this file as ./reference_bag
REFERENCE_RATE=1.0
